[Unit]
Description=Rigged Royale Season 88 battle collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_ROOT__
Environment=PYTHONUNBUFFERED=1
Environment=COLLECTOR_ID=netcup
Environment=COLLECTOR_CYCLE_HOURS=6
Environment=COLLECTOR_RPS=30
# Band balance now comes from the per-band queue cap and the balanced seeds.
# The deficit steering stays off; raise it with `systemctl edit` only if a band
# still lags after a few cycles -- see scripts/collect_season88.sh.
Environment=COLLECTOR_DEFICIT_BIAS=0
Environment=COLLECTOR_MIN_QUEUE_DEPTH=500
ExecStart=/bin/bash __REPO_ROOT__/scripts/collect_season88.sh
Restart=always
RestartSec=20
KillSignal=SIGINT
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__REPO_ROOT__/data __REPO_ROOT__/logs

[Install]
WantedBy=multi-user.target
